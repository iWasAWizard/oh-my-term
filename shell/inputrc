# oh-my-term readline settings, used by bash and every other readline program
# (python REPL, gdb, mysql, and so on). Unknown variables are ignored by older
# readline versions, so this file is safe on old systems.

set bell-style none
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set show-all-if-unmodified on
set menu-complete-display-prefix on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on
set visible-stats on
set skip-completed-text on
set revert-all-at-newline on
set enable-bracketed-paste on
set completion-query-items 200
set page-completions off

# Up and Down search the history for what is already typed
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward

# Ctrl-Left, Ctrl-Right, Ctrl-Delete
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[3;5~": kill-word

# Home, End, Delete in the common terminal flavours
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line
"\eOH": beginning-of-line
"\eOF": end-of-line
"\e[3~": delete-char

# Page Up and Page Down move through the history as well
"\e[5~": history-search-backward
"\e[6~": history-search-forward
