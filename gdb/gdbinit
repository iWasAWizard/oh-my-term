# oh-my-term gdbinit, linked to ~/.gdbinit. Only long-standing settings are used
# here, because gdb stops reading the file at the first unknown command.

set pagination off
set confirm off
set height 0
set width 0

# History survives between sessions
set history save on
set history size 10000
set history filename ~/.gdb_history
set history expansion on

# Output
set disassembly-flavor intel
set print pretty on
set print object on
set print static-members off
set print asm-demangle on
set print elements 256
set print address on

# Behavior
set breakpoint pending on
set disassemble-next-line off
set step-mode off

# Short commands
define hexdump
    if $argc == 2
        x/$arg1xb $arg0
    else
        x/64xb $arg0
    end
end
document hexdump
Hex dump of memory: hexdump ADDRESS [BYTES]
end

define regs
    info registers
end
document regs
Show the general-purpose registers.
end

# Per-machine settings and extensions (pwndbg, GEF, and so on) go in
# ~/.gdbinit.local. The check is done in Python because gdb has no "source if exists".
python
import os
_local = os.path.expanduser("~/.gdbinit.local")
if os.path.exists(_local):
    gdb.execute("source " + _local)
end
